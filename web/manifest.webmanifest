{
  "name": "말한대로",
  "short_name": "말한대로",
  "description": "말만 하세요. 기억은 제가 할게요.",
  "lang": "ko",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eaf6ff",
  "theme_color": "#eaf6ff",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/*",
            "audio/*",
            "image/*",
            "application/*",
            ".txt",
            ".m4a",
            ".mp3",
            ".wav",
            ".jpg",
            ".jpeg",
            ".png"
          ]
        }
      ]
    }
  }
}
