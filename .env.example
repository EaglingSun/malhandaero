# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 저장소에 올리지 않습니다.
# 줄 앞의 #은 "꺼 둔 줄"입니다. 쓰려면 #을 지우세요. 바꾼 뒤에는 서버를 껐다 켭니다.

# ───────── 공통 (필수) ─────────
MALHAN_FAMILY_CODE=            # 가족이 들어올 때 쓰는 코드


# ───────── AI 연결: 하나만 (없어도 직접 적기·캘린더는 됩니다) ─────────

# [1] Claude 구독이 있을 때 — 이 PC에 설치·로그인된 Claude Code를 씁니다 (API 결제 없음). 아무것도 안 적어도 됩니다.
# MALHAN_AI=claude
# MALHAN_CLAUDE_MODEL=               # 짧은 글 모델. 비우면 Claude Code 기본
# MALHAN_CLAUDE_MODEL_LONG=opus      # 1만 자 넘는 긴 글(회의록) 모델. Pro 구독이면 비우는 게 한도에 유리
# MALHAN_LONG_CHARS=10000

# [2] Claude 구독이 없을 때 — 구글 Gemini (aistudio.google.com/apikey 에서 무료 발급, 카드 없음)
#     이 PC에 Claude Code도 있으면 MALHAN_AI=gemini 를 꼭 적어야 Gemini를 씁니다.
# MALHAN_AI=gemini
# GEMINI_API_KEY=
# MALHAN_GEMINI_MODEL=gemini-3.8-flash   # 비우면 기본값. 구글이 "다른 모델을 쓰라"고 하면 알아서 그걸로 다시 시도
# MALHAN_GEMINI_EFFORT=low           # 생각 수준 low | medium | high. 높일수록 느리고 꼼꼼
# MALHAN_GEMINI_FALLBACK=            # 503(수요 폭주)이 계속될 때 대신 쓸 모델. 비우면 이 키로 쓸 수 있는 다른 flash 모델을 찾아 자동으로
# MALHAN_HTTP_TIMEOUT=600            # 바깥 API 답을 기다리는 최대 초

# [3] ChatGPT 구독이 있을 때 — 이 PC에 Codex CLI 설치 후 `codex login` (API 결제 없음)
# MALHAN_AI=codex
# MALHAN_CODEX_MODEL=                # 비우면 Codex 기본

# [4] API 키로 (쓴 만큼 과금)
# ANTHROPIC_API_KEY=                 # Anthropic. MALHAN_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=                    # OpenAI. MALHAN_GPT_MODEL=gpt-5.4-mini

# [5] 그 밖에
# MALHAN_AI=ollama                   # 이 PC의 Ollama (완전 오프라인). MALHAN_OLLAMA_MODEL=qwen3:8b, MALHAN_OLLAMA_URL=http://localhost:11434
# MALHAN_AI=openai                   # OpenAI 호환 서버. MALHAN_OPENAI_BASE_URL= MALHAN_OPENAI_API_KEY= MALHAN_OPENAI_MODEL=
# MALHAN_AI=fake                     # 키 없이 화면만 볼 때 (추출은 가짜)


# ───────── 녹음 파일을 글로 바꾸기 ─────────
# 비우면: faster-whisper가 설치돼 있으면 이 PC에서(whisper), 없고 GEMINI_API_KEY가 있으면 Gemini가 직접 들음. 둘 다 없으면 녹음 파일은 못 받고 글·사진·말하기만
# MALHAN_STT=whisper                 # whisper | gemini 로 고정할 때. Gemini 쪽은 화자 구분을 시도합니다
# MALHAN_WHISPER_MODEL=small         # tiny | base | small | medium | large-v3
# MALHAN_WHISPER_DEVICE=cpu
# MALHAN_GEMINI_STT_MODEL=           # 비우면 MALHAN_GEMINI_MODEL과 같게


# ───────── 그 밖의 설정 ─────────
# MALHAN_GOOGLE_CLIENT_ID=           # 구글 캘린더 연결 (INSTALL.md '구글 캘린더 연결 준비'). 네이버는 설정 없이 화면에서
# MALHAN_GOOGLE_CLIENT_SECRET=
# MALHAN_POST_URL=                   # 공모 게시글 주소. 정하면 「달력」에 좋아요 버튼이 생깁니다
# MALHAN_AUTO_UPDATE=1               # 켤 때·새벽에 새 판을 받아 설치. 끄려면 0
# MALHAN_DATA=                       # 자료를 둘 폴더 (기본: 저장소의 data/)
# MALHAN_PORT=8000
