# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 저장소에 올리지 않습니다.

# 가족이 들어올 때 쓰는 코드 (필수)
MALHAN_FAMILY_CODE=

# AI 연결. 비워 두면 이 PC의 Claude Code 로그인을 씁니다 (API 결제 없음).
# MALHAN_AI=claude        # claude | api | gemini | ollama | openai | fake 로 고정할 때
# ANTHROPIC_API_KEY=      # Anthropic API 키로 쓸 때 (쓴 만큼 과금)
# Claude 구독이 없다면 — 구글 Gemini (aistudio.google.com 에서 무료 키 발급, 무료 티어로 충분)
# GEMINI_API_KEY=
# MALHAN_GEMINI_MODEL=gemini-2.5-flash
# 완전 오프라인 — 이 PC의 Ollama (ollama.com). 작은 모델은 긴 회의록 품질이 떨어집니다
# MALHAN_AI=ollama
# MALHAN_OLLAMA_MODEL=qwen3:8b
# MALHAN_OLLAMA_URL=http://localhost:11434
# MALHAN_MODEL=claude-sonnet-5-5
# Claude Code 방식의 모델: 짧은 글은 Claude Code 기본 모델, 1만 자 넘는 긴 글(회의록)은 opus. 바꾸려면 아래를 푼다
# MALHAN_CLAUDE_MODEL=
# MALHAN_CLAUDE_MODEL_LONG=opus
# MALHAN_LONG_CHARS=10000

# 녹음 파일을 글로 바꾸는 로컬 음성 인식 (faster-whisper 설치 시)
# MALHAN_WHISPER_MODEL=small
# MALHAN_WHISPER_DEVICE=cpu

# 자료를 둘 폴더 (기본: 저장소의 data/)
# MALHAN_DATA=
# 키 없이 화면만 확인할 때: 1
# MALHAN_FAKE_LLM=1

# 구글 캘린더 자동 넣기 (INSTALL.md의 '구글 캘린더 연결 준비' 참고). 네이버는 설정 없이 화면에서 연결합니다.
# MALHAN_GOOGLE_CLIENT_ID=
# MALHAN_GOOGLE_CLIENT_SECRET=

# 켤 때마다 저장소의 새 판을 받아 설치합니다. 끄려면 0
# MALHAN_AUTO_UPDATE=1

# 공모 게시글 주소. 정하면 「달력」 화면에 「좋아요 누르러 가기」 버튼이 생깁니다
# MALHAN_POST_URL=
